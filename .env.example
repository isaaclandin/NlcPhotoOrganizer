# Copy this file to .env.local (already gitignored) for local development.
#
# VITE_DROPBOX_APP_KEY is your Dropbox app's "App key" (client_id) from the
# Dropbox App Console — https://www.dropbox.com/developers/apps. It is a
# public identifier, not a secret: it's safe to embed in the built JS
# bundle. This app never uses the app *secret* — do not put it here or
# anywhere else in this project; PKCE doesn't need it.
VITE_DROPBOX_APP_KEY=placeholder

# Must exactly match a redirect URI registered for this app in the Dropbox
# App Console (including the trailing slash). Local dev serves on Vite's
# default port, 5173.
VITE_DROPBOX_REDIRECT_URI=http://localhost:5173/